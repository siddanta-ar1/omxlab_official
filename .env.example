# Endpoint the contact form POSTs to as JSON.
# Works with any handler that accepts a JSON body — Formspree, Web3Forms,
# a Next route handler, or your own API.
#
#   Formspree:  https://formspree.io/f/<your-form-id>
#   Web3Forms:  https://api.web3forms.com/submit
#
# Leave this unset and the form falls back to opening the visitor's mail
# client with the message prefilled, so it still works on a fresh checkout.
NEXT_PUBLIC_CONTACT_ENDPOINT=
